{
  "expo": {
    "name": "Receiptify",
    "slug": "mobile-new",
    "scheme": "receiptify",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.receiptify.app"
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
